{
  "version": 2,
  "builds": [
    {
      "src": "api/send-booking.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/send-booking.js" },
    { "source": "/(.*)", "destination": "/dist/index.html" }
  ]
}